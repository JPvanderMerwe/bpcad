<?xml version="1.0" encoding="utf-8"?>
<!-- Android masks this to the device's shape, so the mark is authored inside
     the middle 72 dp of a 108 dp canvas and survives circular, squircle and
     rounded-square masks alike. The monochrome layer is what Android 13+
     tints for themed icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome"/>
</adaptive-icon>
