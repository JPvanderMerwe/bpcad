<?xml version="1.0" encoding="utf-8"?>
<!--
  CLEARTEXT IS PERMITTED FOR LOOPBACK ONLY, AND ON PURPOSE.

  Android 9 and later block plain HTTP by default, and bpcad's server speaks
  HTTP. The lazy fix is usesCleartextTraffic="true" on the whole application,
  which permits unencrypted traffic to anywhere - including a hosted backend
  later, silently, with nobody noticing the day it starts mattering.

  So it is permitted for the loopback addresses and nothing else. That is the
  USB test path: `adb reverse tcp:8765 tcp:8765` makes the phone's own
  localhost reach the laptop, so the traffic never leaves the cable and is not
  on any network to be read.

  A LAN address or a hosted server is deliberately NOT here. LAN testing means
  adding the computer's address below and knowing it is unencrypted on the
  wifi; a hosted backend means HTTPS, which needs no exception at all.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- The Android emulator's alias for the host machine. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
